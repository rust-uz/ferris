{
    "version": "0.2.0",
    "description": "Sovereign Rust developer platform CLI for ferris.uz",
    "homepage": "https://ferris.uz",
    "license": "MIT OR Apache-2.0",
    "notes": "To build from source on any system: cargo install ferris-cli",
    "suggest": {
        "Rust": "rust"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/iskurama/ferris-uz/releases/download/v0.2.0/ferris-windows-x64.exe#/ferris.exe",
            "hash": ""
        }
    },
    "bin": "ferris.exe",
    "checkver": {
        "url": "https://crates.io/api/v1/crates/ferris-cli",
        "jsonpath": "$.crate.max_version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iskurama/ferris-uz/releases/download/v$version/ferris-windows-x64.exe#/ferris.exe"
            }
        }
    }
}
